# Copy to .env and fill in.

# Local: matches docker-compose.yml in the repo root. On Railway, use the DATABASE_URL it provides.
DATABASE_URL="postgresql://donationplatform:donationplatform@localhost:5432/donationplatform?schema=public"

# `prisma migrate dev` creates a throwaway DB here to diff schema changes — point this at local
# Postgres (needs CREATEDB on the role) even when DATABASE_URL itself points at a remote/prod
# instance, so migrations never depend on that instance allowing CREATEDB over its proxy.
SHADOW_DATABASE_URL="postgresql://donationplatform:donationplatform@localhost:5432/donationplatform_shadow"

# Any long random string in dev. Use a real secret manager value in production.
JWT_SECRET="dev-secret-change-me"

PORT=4000
NODE_ENV=development

# Redis read cache (optional). Leave it unset and everything still works — reads just go
# straight to Postgres; the cache is an accelerator, never a dependency (see lib/cache.ts).
# Local: matches the redis service in docker-compose.yml. On Railway, add the Redis plugin and
# reference its value as ${{Redis.REDIS_URL}} in the backend service's variables.
REDIS_URL="redis://localhost:6379"

# Only used by `npm run prisma:seed` to create the first admin account.
SEED_ADMIN_PHONE="+910000000000"

# Object storage (CLAUDE.md §6 / D-011) — Supabase Storage, S3-compatible API.
# Get these from your Supabase project: Settings → API (endpoint + service keys) and
# Settings → General (region). Create a bucket in Storage first (e.g. "uploads").
SUPABASE_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_S3_BUCKET="uploads"
SUPABASE_S3_REGION=""

# Background maintenance (lib/maintenance.ts) — notification retention, and later the media
# reaper. Runs in-process every 6h because there is no separate cron service. Set to "true" to
# opt out (tests, or once a real scheduler owns these jobs).
DISABLE_MAINTENANCE_JOBS="false"
