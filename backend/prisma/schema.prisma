generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // `migrate dev` creates a throwaway DB here to diff schema changes — pointed at local Postgres
  // (not Railway) so it never depends on prod infra being reachable/writable for CREATEDB, and
  // so a flaky Railway proxy (as seen this session — main-DB queries fine, shadow-DB creation
  // consistently timing out) can't block local development. See backend/.env.example.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Roles per CLAUDE.md §4 and D-018:
// - USER: the mobile donor/beneficiary account (same account acts as both — D-002/PRD §4)
// - INSTITUTION: NGO / hospital / blood bank / orphanage (web panel, D-007 KYC applies later)
// - ADMIN: super admin on the admin console — can create STAFF logins
// - STAFF: limited admin console role (D-018) — can verify/accept needs and list users,
//          cannot edit users/settings, manage staff, or override confirmed donations
enum Role {
  USER
  INSTITUTION
  ADMIN
  STAFF
}

enum InstitutionType {
  NGO
  HOSPITAL
  BLOOD_BANK
  ORPHANAGE
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// PRD §8.1 — the 8 standard blood groups.
enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// PRD §8.1 — needed only to compute the gender-differentiated India donation-gap rule (D-005).
enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id    String  @id @default(cuid())
  phone String  @unique
  email String?
  name  String?
  role  Role    @default(USER)

  // Profile photo — uploaded by the user via signed URL (D-021). Optional; falls back to initials avatar.
  profilePhotoUrl String?

  // Permanent ("go-to") location captured at registration — basis for notifications (D-010).
  // No real-time GPS / live tracking.
  city String?
  area String?

  // Blood donor profile (PRD §8.1) — all optional/opt-in; a USER only fills these in if they
  // want to appear as a blood donor. Sensitive health data (CLAUDE.md §7): never exposed to
  // anyone but the donor themselves except via the respond flow (§8.5), which is itself consent.
  bloodGroup        BloodGroup?
  dateOfBirth       DateTime?
  gender            Gender?
  lastDonationDate  DateTime?
  availableToDonate Boolean     @default(true)

  // Set once the app registers for push (D-016) — used for the eligible-donor match (§8.4).
  expoPushToken String?
  fcmToken      String?

  // KYC details (Chunk 4) — NGO / hospital / blood bank / orphanage onboarding.
  institutionType    InstitutionType?
  legalName          String?
  registrationNumber String?
  darpanId           String?
  address            String?
  bankAccount        String?
  kycDocumentUrl     String?
  kycPhotos          String[]         @default([])
  kycStatus          KycStatus        @default(NOT_SUBMITTED)
  kycRejectionReason String?

  // --- Orphanage / old-age-home public profile (institutionType == ORPHANAGE) --------------
  // Shown in the mobile directory, edited by the home itself from the web panel. Kept separate
  // from the KYC block above on purpose: KYC is private paperwork an admin reviews, this is the
  // public listing a donor browses.
  about         String?
  childrenCount Int?
  staffCount    Int?
  roomsCount    Int?
  coverPhotoUrl String?

  /// Photos of the home's past work — meals served, celebrations, facilities. Public, shown as a
  /// gallery in the app.
  ///
  /// Deliberately NOT `kycPhotos`: those are identity documents (registration certificates, ID
  /// proofs) that only an admin reviewing KYC should ever see. Keeping the two arrays separate is
  /// what stops a private document ending up in a public gallery.
  galleryPhotos String[] @default([])

  // Per-meal sponsorship price in rupees. Null = that meal isn't offered.
  breakfastCost Int?
  lunchCost     Int?
  dinnerCost    Int?

  /// A home can close its calendar entirely (renovation, festival) without being delisted.
  acceptingBookings Boolean @default(true)

  // Set only for STAFF accounts — which ADMIN created them (D-018).
  createdByAdminId String?
  createdByAdmin   User?   @relation("StaffCreatedBy", fields: [createdByAdminId], references: [id])
  staffCreated     User[]  @relation("StaffCreatedBy")

  postedNeeds            Need[] @relation("NeedsPosted")
  linkedInstitutionNeeds Need[] @relation("NeedsLinkedInstitution")

  contributionsMade      Contribution[] @relation("ContributionsMade")
  contributionsConfirmed Contribution[] @relation("ContributionsConfirmed")

  forumQuestions ForumQuestion[] @relation("QuestionsAuthored")
  forumAnswers   ForumAnswer[]   @relation("AnswersAuthored")
  notifications  Notification[]  @relation("NotificationsReceived")

  bookingsReceived SlotBooking[] @relation("BookingsForOrphanage")
  bookingsMade     SlotBooking[] @relation("BookingsByDonor")

  teamMembers           TeamMember[]           @relation("InstitutionTeam")
  volunteerApplicants   VolunteerApplication[] @relation("ApplicationsToNgo")
  volunteerApplications VolunteerApplication[] @relation("ApplicationsByUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, kycStatus])
  @@index([bloodGroup, city, availableToDonate])
  @@index([fcmToken])
}

// PRD §6.1 — Need types. Only BLOOD and MEAL_SLOT need custom modules (CLAUDE.md §3);
// everything else rides the shared engine below with a type-specific `payload`.
enum NeedType {
  MONEY
  BLOOD
  KIT
  GOODS
  MEAL_SLOT
  SKILL_REQUEST
  QUESTION
}

/// What CAUSE a need serves — a separate axis from `NeedType`, which says how someone donates.
///
/// These are not interchangeable and neither can be derived from the other: an EDUCATION need can
/// be MONEY (school fees) or KIT (books and uniforms); a MONEY need can be MEDICAL, EDUCATION,
/// ANIMALS or DISASTER_RELIEF. Collapsing them into one field is what forces a donor browsing
/// "Education" to instead scan a list of "Money" and guess.
///
/// `lib/needCategory.ts` owns which types each category may take, and is authoritative — clients
/// carry a copy for their dropdowns, but the server rejects anything that doesn't match.
///
/// NGOs is deliberately absent: that tile in the app opens the organisation directory, it is not
/// a kind of need.
enum NeedCategory {
  MEDICAL
  BLOOD
  EDUCATION
  DONATE_ITEMS
  WOMEN_EMPOWERMENT
  ANIMALS
  DISASTER_RELIEF
  INTERNSHIP
  SCRIBES
  ORPHANAGES
}

// PRD §6.8 / D-012 — admin/institution-verified, never self-declared.
enum Urgency {
  NORMAL
  URGENT
  EMERGENCY
}

// PRD §6.2 — shared lifecycle for every Need type.
//   DRAFT -> PENDING_VERIFICATION -> LIVE -> PARTIALLY_FULFILLED -> FULFILLED
//                        \-> REJECTED         \-> EXPIRED / CANCELLED (terminal)
// Transitions are enforced in src/lib/needLifecycle.ts, not just documented here.
/// Notification history — the inbox behind the push.
///
/// Push alone is lossy: a token can be dead, the channel can be silenced, the phone can be off,
/// and Expo drops anything undelivered. This platform has already hit every one of those. A row
/// here is the durable record — the push is just the tap on the shoulder, and everything stays
/// readable in-app afterwards even when delivery failed entirely.
model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  /// Deep-link target, so tapping the row opens the thing it's about.
  needId  String?
  forumId String?

  readAt DateTime?

  createdAt DateTime @default(now())

  /// Newest-first per recipient is the only query this table serves.
  @@index([recipientId, createdAt])
  /// Retention sweeps (lib/notificationRetention.ts) scan by age across ALL recipients, which the
  /// index above can't serve — its leading column is the recipient. Without this the sweep is a
  /// sequential scan of the largest table in the database. Cheap to maintain: `createdAt` only
  /// ever increases, so inserts always append to the right edge of the tree rather than splitting
  /// pages in the middle.
  @@index([createdAt])
}

enum NotificationType {
  /// A blood request matching this donor's group and city went live.
  BLOOD_REQUEST
  /// Someone offered to donate on a need this user posted.
  CONTRIBUTION_RECEIVED
  /// The beneficiary/admin confirmed this user's contribution.
  CONTRIBUTION_CONFIRMED
  /// A need this user posted was verified, rejected or cancelled by an admin.
  NEED_STATUS
  /// Someone answered this user's forum question.
  FORUM_ANSWER
  /// Admin/staff only: a new need is waiting in the verification queue.
  VERIFICATION_QUEUE
}

/// A donor sponsoring a meal at an orphanage / old-age home on a date they choose.
///
/// Deliberately NOT the existing MEAL_SLOT Need. That flow is institution-driven — the home
/// publishes a fixed list of dates and a donor picks one (§10.2). Here the home publishes
/// nothing: **every future date is open**, and a date only becomes unavailable because someone
/// booked it.
///
/// PRIVACY: availability is public, the booking is not. Other donors may learn that a date+meal
/// is taken and nothing else — never who booked it, for what occasion, or for how many people.
model SlotBooking {
  id String @id @default(cuid())

  orphanageId String
  orphanage   User   @relation("BookingsForOrphanage", fields: [orphanageId], references: [id], onDelete: Cascade)

  donorId String
  donor   User   @relation("BookingsByDonor", fields: [donorId], references: [id], onDelete: Cascade)

  /// Calendar day; the meal type carries the time of day.
  date     DateTime
  mealType MealType

  /// "Birthday celebration", "In memory of..." — so the home can prepare. Never shown to others.
  purpose     String?
  peopleCount Int?

  /// Rupees, copied from the home's price at booking time so a later price change cannot
  /// rewrite what a donor already agreed to pay.
  amount Int

  status BookingStatus @default(PENDING)

  /// Mandatory on REJECTED, mirroring D-017 for needs — the donor is always told why.
  rejectionReason String?

  /// Payment proof (D-001: no gateway; the donor pays the home directly, then submits the UTR).
  utr      String? @unique
  proofUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One sponsor per meal per day per home, enforced by the database so two donors racing for
  /// the same slot cannot both win — the same guarantee D-022 gives published meal slots.
  @@unique([orphanageId, date, mealType])
  @@index([orphanageId, date])
  @@index([donorId, createdAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum BookingStatus {
  /// Waiting on the home to accept.
  PENDING
  /// The home accepted; the donor now pays and submits proof.
  ACCEPTED
  /// Payment confirmed by the home (or admin) — the sponsorship is complete.
  CONFIRMED
  REJECTED
  CANCELLED
}

/// A person on an institution's public team ("our team" on the NGO's page).
///
/// Not a User row: most team members will never log in, and inventing accounts for them would
/// put unverifiable people in the platform's user table. This is presentational content the
/// institution controls, same as its gallery.
model TeamMember {
  id String @id @default(cuid())

  institutionId String
  institution   User   @relation("InstitutionTeam", fields: [institutionId], references: [id], onDelete: Cascade)

  name     String
  role     String?
  photoUrl String?

  /// Manual ordering — a founder should be able to sit above a volunteer coordinator.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([institutionId, position])
}

/// Someone offering to volunteer with an NGO, and the NGO's decision on it.
///
/// APPROVED is what makes a user an official member of that NGO — the mobile profile reads this
/// table to show which organisations someone volunteers with.
model VolunteerApplication {
  id String @id @default(cuid())

  ngoId String
  ngo   User   @relation("ApplicationsToNgo", fields: [ngoId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ApplicationsByUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Why they want to help / what they can offer. Shown only to the NGO.
  message      String?
  /// Free text — "weekends", "evenings after 6" — rather than a rigid schedule model.
  availability String?
  /// "Teaching", "Medical", "Logistics".
  skills       String?

  status VolunteerStatus @default(PENDING)

  /// Mandatory on REJECTED (mirrors D-017) — the applicant is always told why.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live application per person per NGO — re-applying updates the existing row rather than
  /// stacking duplicates in the NGO's queue.
  @@unique([ngoId, userId])
  @@index([ngoId, status])
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NeedStatus {
  DRAFT
  PENDING_VERIFICATION
  LIVE
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  EXPIRED
  CANCELLED
}

model Need {
  id          String   @id @default(cuid())
  type        NeedType
  title       String
  description String

  /// The cause this need serves — see the NeedCategory enum for why this is separate from `type`.
  ///
  /// Nullable, and answered by the poster for needs created after this field existed. Rows
  /// predating it were backfilled only where exactly one cause can produce that type — BLOOD and
  /// MEAL_SLOT, plus GOODS which historically only ever came from the donate-items screen.
  ///
  /// MONEY, KIT and SKILL_REQUEST were deliberately left null. Each spans several causes (money
  /// funds medical, education, animals and disaster relief alike), so filing them by the
  /// commonest one would put a wrong claim in front of donors. Null is honestly "not categorised".
  category NeedCategory?

  postedById String
  postedBy   User   @relation("NeedsPosted", fields: [postedById], references: [id])

  status  NeedStatus @default(DRAFT)
  urgency Urgency    @default(NORMAL)

  // Baseline location from the poster (PRD §6.7). Precise geo / exact-location reveal
  // on approval is a later milestone.
  city String?
  area String?

  latitude  Float?
  longitude Float?

  // Optional hospital/blood bank/NGO that can co-verify (D-008) — full institution-assisted
  // verification flow (fast-track, BLOOD-specific) lands with the Blood module (Milestone 4).
  linkedInstitutionId String?
  linkedInstitution   User?   @relation("NeedsLinkedInstitution", fields: [linkedInstitutionId], references: [id])

  adminVerified       Boolean @default(false)
  institutionVerified Boolean @default(false)

  // Mandatory on REJECTED (D-017), shown live to the poster.
  rejectionReason String?

  // Shared across every type (not per-type payload) — any need can carry photos of the
  // situation/kit/item, not just GOODS (whose payload will still separately need `photos[]`
  // once built, for handover-condition photos specifically). Uploaded via the same signed-URL
  // pipeline as Contribution.proofUrl (D-021); capped at 5 server-side.
  photos String[] @default([])

  // Shared (not per-type payload) because the lifecycle engine reads it generically to drive
  // the EXPIRED transition (D-013, PRD §7.1/7.4) without knowing type-specific payload shape.
  // Used by MONEY and KIT (§9.1); null = no deadline.
  deadline DateTime?

  // Type-specific fields (PRD §6.4) — target_amount/upi_id/upi_qr for MONEY (§7.1;
  // raised_amount is server-computed, never client-supplied), blood_group/units for BLOOD, etc.
  // Validated per-type at the API layer once each flow is built (Milestone 2+); stored as JSON
  // here so the shared engine doesn't need a schema change per type.
  payload Json?

  contributions  Contribution[]
  // MEAL_SLOT only (§10.2) — the bookable calendar dates under this need. Empty for every other
  // type.
  mealSlots      MealSlot[]
  // Admin-written success stories that credit this need. Back-relation only; a need never needs
  // to know about them, but Prisma requires the other side of SuccessStory.relatedNeed.
  successStories SuccessStory[] @relation("StoriesFromNeed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, urgency])
  @@index([status, type])
  /// Category browsing ("show me every live Education need"). Leads with `category` because that
  /// is the selective column — every other index here leads with `status`, which only has a
  /// handful of distinct values and so can't narrow a category lookup on its own.
  @@index([category, status])
  @@index([status, city])
  @@index([postedById])
  @@index([linkedInstitutionId])
}

// PRD §6.5 / §7.2-7.3 / §9.2 / §8.5 / §10.4 — a donor acting on a Need. `kind` exists so every
// type's contributions (GOODS/… later) reuse this table instead of inventing a parallel one.
enum ContributionKind {
  MONEY
  KIT
  BLOOD
  MEAL_SLOT
  GOODS
  SKILL_REQUEST
}

enum ContributionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

model Contribution {
  id String @id @default(cuid())

  needId String
  need   Need   @relation(fields: [needId], references: [id])

  donorId String
  donor   User   @relation("ContributionsMade", fields: [donorId], references: [id])

  kind   ContributionKind   @default(MONEY)
  status ContributionStatus @default(PENDING_CONFIRMATION)

  // MONEY: the ₹ amount (required). KIT mode=MONEY / MEAL_SLOT mode=MONEY: server-computed as
  // kits × cost_per_kit / cost_per_slot, same audit-worthy principle as Money (CLAUDE.md §7).
  // KIT/MEAL_SLOT mode=DELIVER: null — no money moves through the platform for a physical
  // delivery / in-person pledge (§9.2/§10.4).
  amount Int?
  // KIT only — how many kits this contribution covers (§9.2). Null for MONEY/BLOOD/MEAL_SLOT.
  kits   Int?
  // BLOOD only — units pledged, usually 1 (§8.5). Null for MONEY/KIT/MEAL_SLOT.
  units  Int?

  // Proof of payment (§7.2/§9.2). Required for MONEY and KIT/MEAL_SLOT mode=MONEY
  // contributions; null for mode=DELIVER and BLOOD (neither ever involves payment). UTR
  // uniqueness is a hard DB constraint (D-019) — nullable + @unique lets Postgres allow multiple
  // NULLs while still enforcing uniqueness among the UTRs that do exist.
  utr      String? @unique
  proofUrl String?

  // MEAL_SLOT only (§10.2-10.3) — the one calendar date this contribution booked. The lock
  // itself lives on MealSlot.status via the conditional UPDATE (D-022); this is just the
  // reverse side of that one-to-one relation.
  mealSlot     MealSlot?
  // MEAL_SLOT only — redundant with mealSlot.date, kept directly on the Contribution so a
  // REJECTED contribution's date survives even after its MealSlot is reopened and its
  // `contributionId` pointer gets overwritten by whoever books that date next (D-022).
  mealSlotDate DateTime?

  // Beneficiary (default) or Admin (override) — D-002, D-018. Never Staff — confirming/
  // overriding a donation is explicitly Admin-only.
  confirmedById String?
  confirmedBy   User?   @relation("ContributionsConfirmed", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([needId])
  @@index([donorId])
  @@index([needId, donorId])
  @@index([needId, status])
  @@index([status])
}

// PRD §10.2-10.3 / D-022 — one row per bookable calendar date under a MEAL_SLOT need. The
// locking guarantee (no two donors book the same date) lives entirely in the conditional
// UPDATE the booking route runs against `status` — see src/routes/needs.ts — not in application
// code, and not in this schema beyond the unique constraint below.
enum MealSlotStatus {
  OPEN
  BOOKED
  CONFIRMED
}

model MealSlot {
  id String @id @default(cuid())

  needId String
  need   Need   @relation(fields: [needId], references: [id])

  date   DateTime
  status MealSlotStatus @default(OPEN)

  // Set once BOOKED (§10.3); cleared back to null when a rejected booking reopens the slot
  // (§10.4) so it can be booked again.
  contributionId String?       @unique
  contribution   Contribution? @relation(fields: [contributionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Structurally impossible to have two rows for the same date on the same need — belt and
  // suspenders alongside the conditional-UPDATE locking pattern (D-022).
  @@unique([needId, date])
  @@index([needId, status])
}

model ForumQuestion {
  id        String        @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User          @relation("QuestionsAuthored", fields: [authorId], references: [id])
  answers   ForumAnswer[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model ForumAnswer {
  id         String        @id @default(cuid())
  body       String
  questionId String
  question   ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation("AnswersAuthored", fields: [authorId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([questionId])
  @@index([authorId])
}

model District {
  id    String @id @default(cuid())
  name  String @unique
  state String @default("Andhra Pradesh")

  // District centre. This is what a create-need form centres its map picker on, and the
  // server-side fallback for a need posted without a pinned coordinate (see needs.ts
  // `resolveNeedCoordinates`). Nullable so an admin-created district isn't blocked on
  // knowing coordinates — a need in a district with no centre simply carries no pin
  // rather than being silently placed somewhere wrong.
  latitude  Float?
  longitude Float?

  areas     Area[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  // Approximate locality centre — preferred over the district centre when resolving a
  // need's fallback coordinate. Null = fall back to the district.
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, name])
  @@index([districtId])
}

// ---------------------------------------------------------------------------------------------
// Community panel (the mobile menu drawer) — three admin-curated content types.
//
// All three are *editorial*, not transactional: nothing here participates in the Need lifecycle,
// nothing here moves money, and none of it is user-generated. That is why each carries its own
// `isActive`/`isPublished` + `sortOrder` instead of a status enum — an admin is arranging a page,
// not moving a request through verification.
//
// The fourth block on that menu, Top Supporters, has no model on purpose: it is derived from
// confirmed Contributions (see routes/community.ts). A stored leaderboard would be a second
// source of truth for money that is already recorded, and could drift from it.
// ---------------------------------------------------------------------------------------------

/// One row in "Safety & Emergency Support". Admin-managed because these numbers change (state
/// helplines get renumbered) and shipping them hardcoded in the app would mean an app-store
/// release to correct a number someone may be dialling in a crisis.
model Helpline {
  id     String @id @default(cuid())
  name   String
  /// Free text, not validated as a phone number: real helplines are short codes (100, 108,
  /// 1098) as well as 10-digit mobiles, and some are published with extensions.
  number String

  /// Admin-uploaded icon (webp/png in the bucket). Falls back to `iconKey` when absent.
  iconUrl String?
  /// Name of a built-in icon to draw instead of an upload — keeps a helpline usable the moment
  /// it is created, before anyone has made artwork for it.
  iconKey String?

  /// Optional grouping label shown under the name ("Mental health", "Women & children").
  category String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// A published "Success Story" — the card carousel in the menu and its own detail page.
model SuccessStory {
  id      String @id @default(cuid())
  title   String
  /// The one or two lines that fit on the carousel card ("Thanks to your support, Kavya is back
  /// to school…"). Kept separate from `body` so the card never renders a truncated paragraph.
  summary String
  /// Full write-up shown behind "Read more".
  body    String

  /// The card image. `images` are the additional photos on the detail page.
  coverImageUrl String?
  images        String[] @default([])

  /// Who the story is about, if the person consented to being named. Optional — a story can be
  /// told without identifying a beneficiary.
  beneficiaryName String?
  /// Optional link back to the need this story came out of, for provenance.
  relatedNeedId   String?
  relatedNeed     Need?   @relation("StoriesFromNeed", fields: [relatedNeedId], references: [id])

  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder, publishedAt])
}

enum EventMode {
  OFFLINE
  ONLINE
}

/// An admin-posted "Upcoming Event" — health camps, workshops, donation drives.
///
/// Named `PlatformEvent` rather than `Event` because `Event` is a global DOM/Node type name and
/// the generated Prisma client type is imported into three TypeScript frontends.
model PlatformEvent {
  id          String @id @default(cuid())
  title       String
  description String

  /// Free-text tag shown on the card ("Health camp", "Workshop", "Blood drive"). Deliberately
  /// not an enum: an admin adding a new kind of event must not need a migration.
  eventType String?

  mode     EventMode @default(OFFLINE)
  /// City / venue name shown on the card. For ONLINE events the app shows "Online" instead.
  location String?
  /// Full address, only shown on the detail page.
  address  String?

  startsAt DateTime
  endsAt   DateTime?

  /// Wide banner for the detail page; `iconUrl` is the small square on the list card.
  bannerUrl String?
  iconUrl   String?

  /// Where to sign up (a form, a WhatsApp link) and who to call. Both optional.
  registrationUrl String?
  contactPhone    String?

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startsAt])
}
